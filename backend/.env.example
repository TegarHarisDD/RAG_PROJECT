# Backend configuration. Copy to .env and fill in real values; .env is
# git-ignored and never committed. Secrets live here only.

# Comma-separated list of browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173

# Added in later tickets, listed here so the convention is visible early:
# OPENROUTER_API_KEY=          # required for embed/generate (ticket 02 onward)
# OPENROUTER_BASE_URL=         # default: https://openrouter.ai/api/v1
# EMBEDDING_MODEL=             # default: liquid/lfm-2.5-embedding-350m:free (1024 dims)
# LLM_MODELS=                  # comma-separated fallback chain (ADR-0001), default:
#                              # qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# MONGODB_URI=
